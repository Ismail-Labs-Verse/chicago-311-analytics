# ---------------------------------------------------------------------------
# Data privacy / repo weight
# Raw and processed data are NEVER committed. Only a tiny representative
# sample (data/samples/, ~1,000 rows) is version-controlled.
# ---------------------------------------------------------------------------
data/raw/
data/processed/

# Keep the small representative sample that ships with the repo
!data/samples/
!data/samples/**

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Secrets / local environment — never commit
# ---------------------------------------------------------------------------
.env
.env.*
*.key
*.pem
secrets/
credentials.json

# ---------------------------------------------------------------------------
# Databases / large derived artifacts
# ---------------------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.parquet
!*.sample.parquet

# Tableau extracts are large (tens to hundreds of MB) -> not committed.
# Regenerate with `python etl.py --dashboards` and open locally in Tableau.
dashboards/*.hyper
dashboards/**/*.hyper

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
*.swp

# Stray nested working copy created outside this session; not a project
# deliverable, so it is excluded rather than committed as an embedded repo.
chicago-311-analytics/
