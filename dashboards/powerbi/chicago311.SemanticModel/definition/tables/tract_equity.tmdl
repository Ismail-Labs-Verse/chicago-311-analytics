	partition tract_equity = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/powerbi_data/tract_equity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Promoted
